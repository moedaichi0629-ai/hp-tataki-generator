# Google Cloud ConsoleでPlaces API・Geocoding APIを有効化して取得したAPIキー
GOOGLE_PLACES_API_KEY=

# OpenAI Platformで取得したAPIキー（口コミからの店舗の強み下書き生成に使用）
OPENAI_API_KEY=

# 使用するOpenAIモデル（省略時は gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# SupabaseプロジェクトのProject URL（Supabaseダッシュボード > Settings > API）
SUPABASE_URL=

# Supabaseのservice_role キー（サーバー専用。絶対にクライアントコードや公開リポジトリに含めないこと）
SUPABASE_SERVICE_ROLE_KEY=

# 第2段階: 画像アップロード用（ブラウザからSupabase Storageへ直接アップロードするために必要）
# SUPABASE_URLと同じ値でOK
NEXT_PUBLIC_SUPABASE_URL=

# Supabaseのanon/publishableキー（公開可能な鍵。Settings > API から取得。ブラウザに公開されて問題ありません）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
